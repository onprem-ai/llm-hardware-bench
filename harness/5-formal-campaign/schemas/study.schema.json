{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-inference-hardware-bench/study.schema.json",
  "title": "Benchmark study record",
  "type": "object",
  "required": ["schema_version", "study_id", "status", "host_ids", "objective", "methodology"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "status": {"enum": ["planned", "active", "complete", "archived"]},
    "host_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "objective": {"type": "string", "minLength": 1},
    "methodology": {"type": "object"},
    "configs": {"type": "object"},
    "external_results_root": {"type": "object"},
    "legacy_results": {"type": "object"},
    "open_todos": {"type": "array", "items": {"type": "string"}}
  }
}
