{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-inference-hardware-bench/run-manifest.schema.json",
  "title": "Benchmark run manifest",
  "type": "object",
  "required": ["schema_version", "campaign_id", "run_id", "status", "profile", "concurrency", "repetition", "artifacts", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {"enum": ["planned", "warming", "settling", "measuring", "exporting", "complete", "failed", "dry_run"]},
    "profile": {"type": "string"},
    "concurrency": {"type": "integer", "minimum": 1},
    "repetition": {"type": "integer", "minimum": 1},
    "random_seed": {"type": "integer"},
    "command": {"type": "array", "items": {"type": "string"}},
    "warmup_command": {"type": "array", "items": {"type": "string"}},
    "start_time": {"type": ["string", "null"]},
    "end_time": {"type": ["string", "null"]},
    "return_code": {"type": ["integer", "null"]},
    "error": {"type": ["string", "null"]},
    "artifacts": {"type": "object"},
    "events": {"type": "array", "items": {"type": "object"}}
  }
}
