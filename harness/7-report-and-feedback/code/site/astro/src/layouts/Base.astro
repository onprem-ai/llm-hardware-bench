---
import { url } from '../lib/url';
import '@fontsource-variable/inter';
import site from '../generated/site.json';
const { title, description, image=url('/assets/hardware.png'), type='website' } = Astro.props;
const canonical = site.site.canonical_url ? new URL(Astro.url.pathname, site.site.canonical_url).toString() : undefined;
---
<!doctype html>
<html lang={site.site.language || 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
<style is:global>
:root{--ink:#13232d;--muted:#657783;--paper:#f4f5f1;--card:#fff;--line:#d6dedb;--blue:#086c83;--orange:#d36b32;--red:#aa4050;--green:#2f7855;--dark:#07141d;--sans:'Inter Variable',Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 var(--sans);font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}a{color:var(--blue);text-decoration-thickness:1px;text-underline-offset:3px}.wrap{width:min(1220px,calc(100% - 40px));margin:auto}.eyebrow{font:750 11px ui-monospace,monospace;letter-spacing:.15em;text-transform:uppercase;color:var(--blue)}h1,h2,.display{font-family:var(--sans)}h1{font-size:clamp(42px,6vw,76px);line-height:1.02;font-weight:800;letter-spacing:-.042em;margin:12px 0 20px}h2{font-size:31px;line-height:1.14;font-weight:750;letter-spacing:-.022em;margin:0 0 8px}h3{font-weight:700;letter-spacing:-.01em}h3{margin:0 0 7px}.muted{color:var(--muted)}.topbar{background:var(--dark);color:#dcecf3}.topbar .wrap{display:flex;justify-content:space-between;align-items:center;padding-block:14px}.topbar a{color:#dcecf3;text-decoration:none}.specs,.kpis,.cards,.grid2{display:grid;gap:14px}.specs{grid-template-columns:repeat(4,1fr);margin-top:26px}.specs div,.kpi,.card,.panel{background:var(--card);border:1px solid var(--line);border-radius:7px;padding:16px}.specs dt,.kpi small{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.specs dd{margin:3px 0;font-weight:750}.section{padding:46px 0;border-bottom:1px solid var(--line)}.kpis{grid-template-columns:repeat(4,1fr)}.kpi strong{display:block;font:750 31px/1.1 var(--sans);letter-spacing:-.025em;color:var(--blue)}.cards{grid-template-columns:repeat(3,1fr)}.card h3{font-size:23px}.card .metric{font:750 25px/1.15 var(--sans);letter-spacing:-.02em;color:var(--blue)}.grid2{grid-template-columns:1fr 1fr}.tablebox{overflow:auto;background:#fff;border:1px solid var(--line);border-radius:7px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{padding:9px 10px;text-align:right;border-bottom:1px solid #e8eeeb;white-space:nowrap}th:first-child,td:first-child{text-align:left}th{font-size:10px;text-transform:uppercase;background:#edf2ef;color:#52626c}.callout{padding:15px 18px;background:#fff8ed;border-left:4px solid var(--orange);margin:18px 0}.breadcrumbs{padding-top:24px;font-size:12px;color:var(--muted)}footer{padding:38px 0;color:var(--muted)}@media(max-width:850px){.grid2{grid-template-columns:1fr}.specs,.kpis,.cards{grid-template-columns:1fr 1fr}}@media(max-width:520px){.specs,.kpis,.cards{grid-template-columns:1fr}.wrap{width:min(100% - 24px,1220px)}}
</style>
