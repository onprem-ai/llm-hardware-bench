---
import { url } from '../../lib/url';
// The full benchmark report, rendered from a publication's normalized_data.
//
// Replaces the previous arrangement, where a standalone HTML report was
// generated by analysis/render_report.py and then scraped apart by prepare.mjs
// and injected here. Because nothing is injected any more, the report inherits
// the site's own stylesheet and the defensive CSS that fought the old report's
// bare `nav {}` / `header {}` rules is gone.
import Section from './Section.astro';
import KindTabs from './KindTabs.astro';
import MeasurementsTable from './MeasurementsTable.astro';
import Reproduce from './Reproduce.astro';
import Procedure from './Procedure.astro';
import ChartFigure from './ChartFigure.astro';
import { buildCatalogue } from '../../lib/catalogue';
import { groupedBarSvg, p2pHeatmapSvg } from '../../lib/fabric';
import { axisOf, resolveSeries, stat, f, type NormalizedData } from '../../lib/report';

interface Props {
  publication: any;
  receipts?: { label: string; href: string; note?: string }[];
}

const { publication, receipts = [] } = Astro.props;
const data: NormalizedData = publication.normalized_data;
const axis = axisOf(publication.axis, data);
const deployment = publication.deployment ?? {};
const ceiling = deployment.active_sequence_ceiling ?? null;
const sections = buildCatalogue({ gpuCount: publication.hardware.gpu_count, ceiling });

const counts = data.source_counts;
const headlines = publication.headlines;
const decodePoints = data.series.decode.points;
const bestDecode = decodePoints.find((p) => p.concurrency === headlines.decode.concurrency);
const power = bestDecode ? stat(bestDecode, 'gpu_board_power') : null;
const temperature = bestDecode ? stat(bestDecode, 'gpu_temperature') : null;

// Repetition count decides whether the central values are medians of a
// distribution or single observations. Saying so is a reporting requirement.
const repetitions = [...Object.values(data.series)].flatMap((series) =>
  series.points.map((point) => stat(point, 'throughput')?.n ?? 1),
);
const singleRepetition = Math.max(...repetitions) === 1;
const statisticText = singleRepetition
  ? 'Each point is one qualification measurement; no repetition variance is established.'
  : 'Central values are medians; bands show the observed repetition range.';

// Host fabric.
const fabric = data.host_fabric ?? null;
const collectives: [string, string][] = [
  ['all_reduce_perf', 'All-reduce'],
  ['all_gather_perf', 'All-gather'],
  ['reduce_scatter_perf', 'Reduce-scatter'],
];
const median = (rows: any[], field: string): number | null => {
  const values = rows.map((r) => r[field]).filter((v) => typeof v === 'number' && Number.isFinite(v)).sort((a, b) => a - b);
  if (!values.length) return null;
  const mid = Math.floor(values.length / 2);
  return values.length % 2 ? values[mid] : (values[mid - 1] + values[mid]) / 2;
};
const comparisons = fabric?.nccl_comparisons ?? [];
const bandwidthGroups = collectives.map(([key, label]) => {
  const rows = comparisons.filter((r: any) => r.collective === key);
  return { label, values: [median(rows, 'local_busbw_gbps'), median(rows, 'cross_numa_busbw_gbps'), median(rows, 'remote_cpu_busbw_gbps')] };
});
const penaltyGroups = collectives.map(([key, label]) => {
  const rows = comparisons.filter((r: any) => r.collective === key);
  return { label, values: [median(rows, 'cross_numa_penalty_pct'), median(rows, 'remote_cpu_penalty_pct')] };
});

const rangeKpi = (item: any, suffix: string, label: string, digits = 2) => {
  if (!item || item.minimum === null || item.maximum === null) return { value: 'unavailable', label, detail: null };
  const central = (item.minimum + item.maximum) / 2;
  return {
    value: `${central.toFixed(0)}${suffix}`,
    label,
    detail: `Observed variation: ${item.minimum.toFixed(digits)}-${item.maximum.toFixed(digits)}${suffix}`,
  };
};
const fabricKpis = fabric
  ? [
      rangeKpi(fabric.same_numa_all_reduce_busbw_gbps, ' GB/s', 'NCCL TP4 all-reduce bus bandwidth, same NUMA'),
      rangeKpi(fabric.cross_numa_all_reduce_busbw_gbps, ' GB/s', 'NCCL TP4 all-reduce bus bandwidth, cross NUMA'),
      rangeKpi(fabric.cross_numa_penalty_pct, '%', 'Cross-NUMA all-reduce penalty', 1),
      rangeKpi(fabric.remote_cpu_penalty_pct, '%', 'Remote CPU/memory placement penalty', 1),
    ]
  : [];

const unavailable = (value: unknown) => (value === null || value === undefined || value === '' ? 'unavailable' : String(value));
const navLinks = [
  { id: 'summary', label: 'Summary' },
  ...sections.map((s) => ({ id: s.id, label: s.navLabel })),
  { id: 'fabric', label: 'Fabric' },
  { id: 'method', label: 'Method' },
  { id: 'data', label: 'Data' },
  { id: 'reproduce', label: 'Reproduce' },
  { id: 'procedure', label: 'Procedure' },
];
---

{/* Report-wide decode/prefill state. Must precede every panel it controls. */}
<input type="radio" name="kind" id="kind-decode" class="kind-state" checked />
<input type="radio" name="kind" id="kind-prefill" class="kind-state" />

<header class="report-hero">
  <div class="wrap">
    <div class="eyebrow">Performance Benchmark · {publication.report?.date ?? 'campaign record'}</div>
    <h1>{publication.model.name} on {publication.hardware.model}</h1>
    {publication.report?.subtitle && <p class="deck">{publication.report.subtitle}</p>}
    <p class="deck">
      Measurements of input processing, output generation, latency, GPU energy, host resources, and serving
      behavior across global concurrency C1–C{axis.max}.
    </p>
    <p class="meta">
      <span><b>Host</b> {publication.hardware.host}</span>
      <span><b>Topology</b> {deployment.summary}</span>
      <span><b>GPUs</b> {publication.hardware.gpu_count}× {publication.hardware.gpu_model}</span>
      <span><b>Campaign</b> {f(counts.runs)} runs / {f(counts.requests)} requests</span>
      <span class={counts.errors ? 'bad' : 'good'}>{f(counts.errors)} errors</span>
    </p>
  </div>
</header>

<nav class="report-nav" aria-label="Report sections">
  <div class="wrap">
    {navLinks.map((link) => <a href={`#${link.id}`}>{link.label}</a>)}
  </div>
</nav>

<main class="wrap report-body">
  <section id="summary" class="report-section">
    <div class="eyebrow">01 · Executive summary</div>
    <h2>Best measured Prefill and Decode capacity</h2>
    <div class="kpis">
      <div class="kpi">
        <strong>{f(headlines.decode.value)}</strong>
        <small>output tokens/s at C{headlines.decode.concurrency}</small>
      </div>
      <div class="kpi">
        <strong>{f(headlines.prefill.value)}</strong>
        <small>input tokens/s at C{headlines.prefill.concurrency}</small>
      </div>
      <div class="kpi">
        <strong>{power ? f(power.median) : '—'}</strong>
        <small>GPU board power (W) at peak decode</small>
      </div>
      <div class="kpi">
        <strong>{temperature ? f(temperature.median, 1) : '—'}</strong>
        <small>GPU temperature (°C) at peak decode</small>
      </div>
    </div>
    <p class="statistic">{statisticText}</p>
  </section>

  {sections.map((section) => <Section section={section} data={data} axis={axis} />)}

  <section id="fabric" class="report-section">
    <div class="eyebrow">Host fabric qualification</div>
    <h2>PCIe, NCCL, P2P, and NUMA</h2>
    <p class="sub">Active host-level microbenchmarks are separate from inference-window endpoint telemetry.</p>
    {!fabric ? (
      <div class="callout"><b>Unavailable.</b> No host-fabric qualification input was supplied.</div>
    ) : (
      <Fragment>
        <div class="kpis">
          {fabricKpis.map((kpi) => (
            <div class="kpi">
              <strong>{kpi.value}</strong>
              <small>{kpi.label}</small>
              {kpi.detail && <p class="kpi-detail">{kpi.detail}</p>}
            </div>
          ))}
        </div>
        <div class="grid2">
          <div class="panel">
            <h3>NCCL bandwidth by collective and placement</h3>
            <Fragment set:html={groupedBarSvg(bandwidthGroups, ['Same NUMA', 'Cross NUMA', 'Remote CPU'], 'BUS BANDWIDTH (GB/s)')} />
          </div>
          <div class="panel">
            <h3>NUMA and placement penalties</h3>
            <Fragment set:html={groupedBarSvg(penaltyGroups, ['Cross NUMA', 'Remote CPU'], 'PENALTY (%)')} />
          </div>
          <div class="panel">
            <h3>CUDA P2P unidirectional bandwidth</h3>
            <Fragment set:html={p2pHeatmapSvg(fabric.p2p_bandwidth_matrix ?? [], 'unidirectional', publication.hardware.gpu_count)} />
          </div>
          <div class="panel">
            <h3>CUDA P2P bidirectional bandwidth</h3>
            <Fragment set:html={p2pHeatmapSvg(fabric.p2p_bandwidth_matrix ?? [], 'bidirectional', publication.hardware.gpu_count)} />
          </div>
        </div>
        <div class="callout">
          <b>Interpretation boundary.</b> Per-run DCGM PCIe RX/TX values are aggregate GPU-endpoint rates, not direct
          internal PCIe-switch port counters. UPI telemetry: {unavailable(fabric.upi?.status)}.
        </div>
        {fabric.limitations?.length > 0 && (
          <div class="note">
            <b>Fabric limitations</b>
            <ul>{fabric.limitations.map((item: string) => <li>{item}</li>)}</ul>
            <p class="foot">Source: <code>{fabric.source}</code></p>
          </div>
        )}
      </Fragment>
    )}
  </section>

  <section id="method" class="report-section">
    <div class="eyebrow">10 · Method</div>
    <h2>Measurement design and topology</h2>
    <p>
      Each operating point uses repeated measurements, warm-up, settling, streaming output, and closed-loop global
      concurrency. Exact details remain in campaign manifests.
    </p>
    <dl class="specs">
      <div><dt>Topology</dt><dd>{deployment.summary}</dd></div>
      <div><dt>Request path</dt><dd>{deployment.request_path ?? 'unavailable'}</dd></div>
      <div><dt>Model</dt><dd>{publication.model.repository}</dd></div>
      <div><dt>Revision</dt><dd><code>{String(publication.model.revision).slice(0, 12)}…</code></dd></div>
      <div><dt>Quantization</dt><dd>{publication.model.quantization}</dd></div>
      <div><dt>KV-cache dtype</dt><dd>{unavailable(deployment.kv_cache_dtype)}</dd></div>
      <div><dt>Speculative decoding</dt><dd>{unavailable(deployment.speculative_decoding)}</dd></div>
      <div><dt>Max model length</dt><dd>{deployment.max_model_len ? f(deployment.max_model_len) : 'unavailable'}</dd></div>
      <div><dt>Sequences per replica</dt><dd>{deployment.max_num_seqs_per_replica ? f(deployment.max_num_seqs_per_replica) : 'unavailable'}</dd></div>
      <div><dt>Batched tokens per replica</dt><dd>{deployment.max_num_batched_tokens_per_replica ? f(deployment.max_num_batched_tokens_per_replica) : 'unavailable'}</dd></div>
      <div><dt>Active-sequence ceiling</dt><dd>{ceiling ? f(ceiling) : 'unavailable'}</dd></div>
      <div><dt>CPU / NUMA affinity</dt><dd>{unavailable(deployment.cpu_numa_affinity)}</dd></div>
    </dl>
    <p class="statistic">{statisticText}</p>
    {publication.notes?.length > 0 && (
      <div class="note">
        <b>Provenance</b>
        <ul>{publication.notes.map((note: string) => <li>{note}</li>)}</ul>
      </div>
    )}
  </section>

  <section id="data" class="report-section">
    <div class="eyebrow">11 · Selected measurements</div>
    <h2>Median values and repetition ranges</h2>
    <KindTabs />
    <div class="panel-decode"><MeasurementsTable data={data} kind="decode" /></div>
    <div class="panel-prefill"><MeasurementsTable data={data} kind="prefill" /></div>

    {receipts.length > 0 && (
      <div class="note">
        <b>Source data</b>
        <p>Every value above is derived from these files.</p>
        <ul>
          {receipts.map((receipt) => (
            <li><a href={url(receipt.href)} download>{receipt.label}</a>{receipt.note && <span class="muted"> — {receipt.note}</span>}</li>
          ))}
        </ul>
        <p class="foot">Campaign: <code>{data.source_campaign}</code></p>
      </div>
    )}

      {data.exclusions && data.exclusions.length > 0 && (
        <div class="note">
          <b>Excluded runs</b>
          <ul>{data.exclusions.map((x) => <li><code>{x.run_id}</code> — {x.reason}</li>)}</ul>
        </div>
      )}
    </section>

    <Reproduce publication={publication} />
    <Procedure publication={publication} />
  </main>

<style>
  /* Decode/prefill toggle. The inputs are visually hidden but must stay
     focusable, so they are offset rather than display:none. */
  .kind-state {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  :global(.kind-tabs) {
    display: flex;
    gap: 8px;
    margin: 0 0 16px;
  }
  :global(.kind-tab) {
    cursor: pointer;
    border: 1px solid var(--line);
    background: #fff;
    padding: 7px 15px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    user-select: none;
  }
  #kind-decode:checked ~ * :global(.kind-tab-decode),
  #kind-prefill:checked ~ * :global(.kind-tab-prefill) {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  #kind-decode:checked ~ * :global(.panel-prefill),
  #kind-prefill:checked ~ * :global(.panel-decode) {
    display: none;
  }

  .report-hero {
    background: linear-gradient(135deg, #e7f2ef, #fbf8ef);
    border-bottom: 1px solid var(--line);
    padding: 46px 0 34px;
  }
  .report-hero h1 {
    max-width: 20ch;
  }
  .deck {
    font-size: 18px;
    color: #40535f;
    max-width: 74ch;
    margin: 0 0 12px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    margin: 22px 0 0;
    font-size: 13px;
  }
  .meta b {
    color: var(--muted);
    font-weight: 700;
    margin-right: 6px;
  }
  .meta .good { color: var(--green); font-weight: 700; }
  .meta .bad { color: var(--red); font-weight: 700; }

  .report-nav {
    position: sticky;
    top: var(--shell-h, 0px);
    z-index: 9;
    background: #f6f7f4ef;
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .report-nav .wrap {
    display: flex;
    gap: 18px;
    overflow: auto;
  }
  .report-nav a {
    padding: 12px 0;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
  }
  .report-nav a:hover { color: var(--ink); }

  /* Global, not scoped: Section.astro renders these same classes as a separate
     component, so a scoped rule would style only the sections written inline
     here and leave the catalogue sections with no spacing or scroll offset. */
  :global(.report-section) {
    padding: 30px 0 26px;
    scroll-margin-top: calc(var(--shell-h, 0px) + 52px);
  }
  :global(.report-section > .eyebrow) { margin-bottom: 10px; }
  :global(.sub) { color: var(--muted); max-width: 80ch; }
  .statistic { color: var(--muted); font-size: 13px; }

  :global(.chart-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  :global(.chart-figure) {
    margin: 0;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 16px;
  }
  :global(.chart-heading) {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  :global(.chart) { width: 100%; height: auto; display: block; }
  :global(.fabric-svg) { width: 100%; height: auto; display: block; }
  :global(.chart-note) { color: var(--muted); font-size: 12px; margin: 8px 0 0; }
  :global(.chart-data) { margin-top: 12px; font-size: 12px; }
  :global(.chart-data summary) {
    cursor: pointer;
    color: var(--blue);
    font-weight: 700;
  }
  :global(.chart-data .tablebox) { margin-top: 10px; }
  :global(.unavailable) {
    background: #f5f7f6;
    color: var(--muted);
    padding: 28px;
    text-align: center;
    font-weight: 700;
  }

  .kpi-detail { margin: 6px 0 0; font-size: 11px; color: var(--muted); font-weight: 400; }
  .note {
    background: #fff;
    border: 1px solid var(--line);
    padding: 16px 18px;
    margin-top: 20px;
  }
  .note ul { margin: 8px 0 0; padding-left: 18px; }
  .note li { margin-bottom: 4px; }
  .foot { color: var(--muted); font-size: 12px; margin-bottom: 0; }
  .specs { grid-template-columns: repeat(3, 1fr); }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    :global(.chart-grid) { grid-template-columns: 1fr; }
    .specs { grid-template-columns: 1fr 1fr; }
  }
</style>
