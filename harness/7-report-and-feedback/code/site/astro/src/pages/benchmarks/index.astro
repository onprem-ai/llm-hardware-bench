---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';import Nav from '../../components/Nav.astro';import site from '../../generated/site.json';import devices from '../../generated/devices.json';
const jsonld={'@context':'https://schema.org','@type':'CollectionPage','name':site.site.title,'description':site.site.description,'mainEntity':devices.map(d=>({'@type':'Product','name':d.model,'manufacturer':{'@type':'Organization','name':d.manufacturer}}))};
---
<Base title={site.site.title} description={site.site.description}><script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)}/><Nav/><main class="wrap"><section class="section"><h1>Frontier LLMs on Bare Metal<br/>Raw Performance Benchmarks</h1><p class="muted">{site.site.description}</p><div class="device-list">{devices.map(device=><article class="device-row"><div class="device-image"><img src={url(`/assets/${device.label}${device.imageExtension||'.png'}`)} alt={`${device.manufacturer} ${device.model}`}/></div><div><h2>{device.model}</h2><dl class="device-specs">{device.specs.map(x=><div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}</dl><h3>Benchmarked models</h3><ul class="model-list">{device.publications.map(b=><li><a href={url(`/benchmarks/${device.label}/${b.id}/`)}><strong>{b.model.name}</strong><span>{Math.round(b.headlines.decode.value).toLocaleString()} tok/s gen · {Math.round(b.headlines.prefill.value).toLocaleString()} tok/s prompt</span></a></li>)}</ul></div></article>)}</div></section></main><style>.device-list{display:grid;gap:22px}.device-row{display:grid;grid-template-columns:minmax(280px,.8fr) 1.2fr;gap:32px;padding:26px;background:#fff;border:1px solid var(--line);border-radius:10px}.device-image{display:grid;place-items:center;background:linear-gradient(135deg,#e7f0ee,#fbf6ea);border-radius:8px;overflow:hidden;padding:18px}.device-image img{width:100%;height:100%;object-fit:contain;display:block}.device-specs{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px}.device-specs div{border-bottom:1px solid var(--line);padding:7px 0}.device-specs dt{color:var(--muted);font-size:11px;text-transform:uppercase}.device-specs dd{margin:2px 0;font-weight:700}.model-list{list-style:none;padding:0;display:grid;gap:7px}.model-list a{display:flex;justify-content:space-between;gap:16px;padding:11px 13px;border:1px solid var(--line);border-radius:6px;text-decoration:none}.model-list span{color:var(--muted);text-align:right}@media(max-width:800px){.device-row{grid-template-columns:1fr}.model-list a{display:block}.model-list span{display:block;text-align:left}}</style></Base>
