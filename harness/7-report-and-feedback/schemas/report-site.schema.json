{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-inference-hardware-bench/report-site.schema.json",
  "title": "Hardware benchmark report site",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site", "devices"],
  "properties": {
    "schema_version": {"const": 1},
    "site": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "canonical_url"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 50},
        "canonical_url": {"type": ["string", "null"], "format": "uri"},
        "language": {"type": "string", "default": "en"},
        "publisher": {"type": ["string", "null"]}
      }
    },
    "devices": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/device"}
    }
  },
  "$defs": {
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {"label": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "model", "manufacturer", "summary", "image", "specs", "benchmarks"],
      "properties": {
        "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "model": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 50},
        "image": {"type": "string", "minLength": 1},
        "specs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spec"}},
        "benchmarks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^/].*\\.json$"}},
        "order": {"type": "integer", "comment": "Position in the device list; lower comes first. Devices without it sort after those with it, by host directory name."}
      }
    }
  }
}
